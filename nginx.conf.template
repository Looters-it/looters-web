# Serves the SPA and forwards /api and /ws to the api service, so the browser uses one origin.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Behind another proxy (the TLS terminator in production) the client address comes
  # from its X-Forwarded-For; REAL_IP_FROM is the network that proxy is trusted on.
  # The default trusts nobody, so the header of a client is never believed.
  set_real_ip_from ${REAL_IP_FROM};
  real_ip_header X-Forwarded-For;

  include /etc/nginx/security-headers.conf;

  # Map tiles and JSON compress well; the api sends them uncompressed.
  gzip on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types application/vnd.mapbox-vector-tile application/json application/javascript text/css image/svg+xml;

  # Resolve `api` at request time: nginx then starts even while the api is still booting.
  resolver 127.0.0.11 valid=10s;
  set $api http://api:3000;

  location /api/ {
    # Geo files are large: keep this at least as high as the api's UPLOAD_MAX_MB,
    # and stream them to the api instead of buffering them here first.
    client_max_body_size 300m;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_pass $api;
    proxy_set_header Host $host;
    # Overwritten, not appended: the api trusts this header for rate limiting.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ws {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    # Overwritten, not appended: the api trusts this header for rate limiting.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 1h;
  }

  # A location with its own add_header drops those of the server: they are included again.
  location /fonts/ {
    expires 30d;
    add_header Cache-Control "public";
    include /etc/nginx/security-headers.conf;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/security-headers.conf;
  }

  location / {
    # The page itself is never cached: it names the assets of the current release.
    add_header Cache-Control "no-cache";
    include /etc/nginx/security-headers.conf;
    try_files $uri /index.html;
  }
}
