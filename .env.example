# Development only: where the Vite dev server forwards /api and /ws.
# In containers nginx proxies them to the api service, so the browser always uses one origin.
API_PROXY_TARGET=http://localhost:3000

# Background map tiles (build time). The default is the public OpenStreetMap server, for development only.
# VITE_BASE_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
